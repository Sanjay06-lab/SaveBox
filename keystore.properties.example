# Copy this file to "keystore.properties" (same folder) and fill in your own values.
# keystore.properties is ignored by git - NEVER commit it or your .jks file.
#
# Create a key once with (from the SaveBox folder):
#   keytool -genkeypair -v -keystore savebox-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias savebox
#
# Keep the .jks file and passwords safe and backed up: without them you can never
# publish an update to the same app on the Play Store.

storeFile=savebox-release.jks
storePassword=CHANGE_ME
keyAlias=savebox
keyPassword=CHANGE_ME
